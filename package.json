{
  "name": "devbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "verify:affected": "bash .github/scripts/verify-affected.sh",
    "verify:all": "bash .github/scripts/verify-affected.sh --all",
    "feature:scaffold": "python3 .github/scripts/scaffold-product-feature.py",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:frontend": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
